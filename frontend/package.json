{
  "name": "shop-imt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front SHOP'IMT : Vue 3, TypeScript, Vite, vue-i18n",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src/ eslint.config.ts vite.config.ts",
    "format:check": "prettier --check src/ eslint.config.ts vite.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^20.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
